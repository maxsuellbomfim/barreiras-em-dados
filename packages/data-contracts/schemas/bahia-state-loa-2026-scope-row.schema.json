{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barreirasemdados.org/schemas/bahia-state-loa-2026-scope-row/1-0-0",
  "title": "Bahia state LOA 2026 private reconciliation scope row",
  "description": "Linha estrutural do universo estadual da LOA 2026, preservada somente para provar unicidade antes de qualquer atribuicao financeira territorial.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "fiscal_year",
    "annex_code",
    "amendment_number",
    "author_name",
    "author_external_code",
    "agency_code",
    "budget_unit_code",
    "action_code",
    "author_page_number",
    "author_evidence_text",
    "author_evidence_sha256",
    "page_number",
    "evidence_text",
    "evidence_sha256",
    "source_url",
    "source_artifact_sha256",
    "parser_version",
    "visibility"
  ],
  "properties": {
    "schema_name": { "const": "bahia-state-loa-2026-scope-row" },
    "schema_version": { "const": "1.0.0" },
    "fiscal_year": { "const": 2026 },
    "annex_code": { "const": "I" },
    "amendment_number": { "type": "string", "pattern": "^\\d{1,6}$" },
    "author_name": { "type": "string", "minLength": 1 },
    "author_external_code": { "type": "string", "pattern": "^\\d{5,7}$" },
    "agency_code": { "type": "string", "minLength": 2 },
    "budget_unit_code": { "type": "string", "minLength": 2 },
    "action_code": { "type": "string", "pattern": "^\\d{1,8}$" },
    "author_page_number": { "type": "integer", "minimum": 1 },
    "author_evidence_text": { "type": "string", "minLength": 1 },
    "author_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "page_number": { "type": "integer", "minimum": 1 },
    "evidence_text": { "type": "string", "minLength": 1 },
    "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_url": { "type": "string", "pattern": "^https://" },
    "source_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "parser_version": { "const": "bahia-state-loa-scope/1.0.0" },
    "visibility": { "const": "private_reconciliation_scope" }
  }
}
