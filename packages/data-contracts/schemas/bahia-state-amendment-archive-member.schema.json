{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barreirasemdados.org/schemas/bahia-state-amendment-archive-member/1-0-0",
  "title": "Bahia state parliamentary amendment archive member manifest",
  "description": "Manifesto tecnico de um CSV preservado no ZIP oficial da Bahia, sem valores financeiros normalizados nem atribuicao territorial.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "member_name",
    "columns",
    "row_count",
    "row_count_status",
    "physical_line_count",
    "uncompressed_bytes",
    "compressed_bytes",
    "content_sha256"
  ],
  "properties": {
    "member_name": {
      "type": "string",
      "pattern": "^VW_[A-Z0-9_]+\\.csv$"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "row_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "row_count_status": {
      "type": "string",
      "enum": ["validated", "source_csv_malformed"]
    },
    "physical_line_count": { "type": "integer", "minimum": 0 },
    "uncompressed_bytes": { "type": "integer", "minimum": 1 },
    "compressed_bytes": { "type": "integer", "minimum": 1 },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
