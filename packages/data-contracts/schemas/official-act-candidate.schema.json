{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barreirasemdados.org/schemas/official-act-candidate/1-0-0",
  "title": "Official act candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "candidate_key",
    "act_kind",
    "person_name",
    "position_title",
    "public_body_name",
    "department_name",
    "act_date",
    "effective_from",
    "field_states",
    "extraction",
    "evidence"
  ],
  "properties": {
    "schema_name": {
      "const": "official-act-candidate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "candidate_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "act_kind": {
      "enum": ["appointment", "dismissal"]
    },
    "person_name": {
      "type": "string",
      "minLength": 1
    },
    "position_title": {
      "type": ["string", "null"]
    },
    "public_body_name": {
      "type": ["string", "null"]
    },
    "department_name": {
      "type": ["string", "null"]
    },
    "act_date": {
      "type": "string",
      "format": "date"
    },
    "effective_from": {
      "type": ["string", "null"],
      "format": "date"
    },
    "field_states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_name",
        "position_title",
        "public_body_name",
        "department_name",
        "act_date",
        "effective_from"
      ],
      "properties": {
        "person_name": {
          "$ref": "#/$defs/field_state"
        },
        "position_title": {
          "$ref": "#/$defs/field_state"
        },
        "public_body_name": {
          "$ref": "#/$defs/field_state"
        },
        "department_name": {
          "$ref": "#/$defs/field_state"
        },
        "act_date": {
          "$ref": "#/$defs/field_state"
        },
        "effective_from": {
          "$ref": "#/$defs/field_state"
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "parser_version"],
      "properties": {
        "method": {
          "enum": ["deterministic", "model_assisted", "human"]
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        },
        "model_name": {
          "type": ["string", "null"]
        },
        "prompt_version": {
          "type": ["string", "null"]
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "evidence-item.schema.json"
      }
    }
  },
  "$defs": {
    "field_state": {
      "enum": ["exact", "uncertain", "missing", "conflict"]
    }
  }
}
