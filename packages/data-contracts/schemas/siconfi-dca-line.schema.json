{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barreiras360.org/schemas/siconfi-dca-line.schema.json",
  "title": "Linha oficial da DCA do SICONFI",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exercicio",
    "instituicao",
    "cod_ibge",
    "uf",
    "anexo",
    "rotulo",
    "coluna",
    "cod_conta",
    "conta",
    "valor",
    "populacao"
  ],
  "properties": {
    "exercicio": { "type": "integer", "minimum": 2013, "maximum": 2100 },
    "instituicao": { "type": "string", "minLength": 1 },
    "cod_ibge": { "const": 2903201 },
    "uf": { "const": "BA" },
    "anexo": { "type": "string", "pattern": "^DCA-Anexo " },
    "rotulo": { "type": "string", "minLength": 1 },
    "coluna": { "type": "string", "minLength": 1 },
    "cod_conta": { "type": "string", "minLength": 1 },
    "conta": { "type": "string", "minLength": 1 },
    "valor": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
    "populacao": { "type": "integer", "minimum": 0 }
  }
}
