# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL/Supabase — server-side only
# Em conexão remota, use login dedicado e sslmode=require ou verify-full.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Temporária no ensaio; produção requer credencial restrita ao bucket/prefixo.
SUPABASE_SECRET_KEY=
SUPABASE_RAW_ARTIFACTS_BUCKET=raw-artifacts

# Public web client — never place a secret/service role key here
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Collectors
QUERIDO_DIARIO_BASE_URL=https://api.queridodiario.ok.org.br
QUERIDO_DIARIO_TERRITORY_ID=2903201
QUERIDO_DIARIO_REQUESTS_PER_MINUTE=30
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=5
