# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Persistência local padrão — nunca publicar a pasta data/
PERSISTENCE_MODE=filesystem
LOCAL_DATA_DIRECTORY=data/local-evidence

# Adaptador opcional PostgreSQL + Supabase Storage — server-side only
# Para ativar no futuro, use PERSISTENCE_MODE=postgres-supabase.
# Em conexão remota, use login dedicado e sslmode=require ou verify-full.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Usuário Auth técnico cadastrado manualmente e autorizado por UUID/prefixo.
SUPABASE_WORKLOAD_EMAIL=
SUPABASE_WORKLOAD_PASSWORD=
SUPABASE_RAW_ARTIFACTS_BUCKET=raw-artifacts

# Public web client — never place a secret/service role key here
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Collectors
QUERIDO_DIARIO_BASE_URL=https://api.queridodiario.ok.org.br
QUERIDO_DIARIO_TERRITORY_ID=2903201
QUERIDO_DIARIO_REQUESTS_PER_MINUTE=30
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=5
