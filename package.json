{
  "name": "barreiras-em-dados",
  "version": "0.0.0",
  "private": true,
  "description": "Plataforma cívica municipal orientada a evidências.",
  "workspaces": [
    "apps/*",
    "services/*",
    "workers/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check:contracts": "node packages/data-contracts/scripts/validate-schemas.mjs",
    "check:migration": "node packages/database/scripts/test-foundation-migration.mjs && node packages/database/scripts/test-integral-gazette-documents.mjs && node packages/database/scripts/test-public-obligations-migration.mjs && node packages/database/scripts/test-parliamentary-transfers-migration.mjs",
    "check:sources": "node packages/data-contracts/scripts/validate-source-observations.mjs",
    "check:source-catalog": "node packages/data-contracts/scripts/validate-source-catalog.mjs",
    "test": "node --test",
    "supabase": "node node_modules/supabase/dist/supabase.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supabase": "2.111.0"
  }
}
